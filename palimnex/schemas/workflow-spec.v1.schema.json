{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palimnex:project-memory:workflow-spec:v1",
  "title": "Palimnex dry-run workflow specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "preconditions",
          "expected",
          "rollback",
          "side_effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          },
          "side_effect": {
            "enum": [
              "none",
              "read",
              "local_write",
              "external_write",
              "destructive"
            ]
          }
        }
      }
    }
  }
}
