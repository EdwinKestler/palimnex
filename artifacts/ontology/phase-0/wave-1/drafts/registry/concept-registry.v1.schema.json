{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimnex.dev/schemas/concept-registry.v1.schema.json",
  "title": "Draft Palimnex concept registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "registry_version",
    "registry_kind",
    "concepts",
    "registry_digest",
    "authority",
    "authorizes_actions"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "palimnex:concept-registry:v1",
      "minLength": 28,
      "maxLength": 28
    },
    "project": {
      "$ref": "#/$defs/projectIdentity"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "registry_kind": {
      "type": "string",
      "enum": [
        "approved_registry",
        "candidate_set"
      ],
      "minLength": 13,
      "maxLength": 17
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "authority": {
      "type": "string",
      "const": "historical_only",
      "minLength": 15,
      "maxLength": 15
    },
    "authorizes_actions": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "registry_kind": {
            "const": "approved_registry"
          }
        },
        "required": [
          "registry_kind"
        ]
      },
      "then": {
        "properties": {
          "concepts": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/concept"
                },
                {
                  "properties": {
                    "status": {
                      "enum": [
                        "approved",
                        "superseded",
                        "withdrawn"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "concepts": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/concept"
                },
                {
                  "properties": {
                    "status": {
                      "enum": [
                        "candidate",
                        "withdrawn"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_slug",
        "project_id"
      ],
      "properties": {
        "project_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        }
      }
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128
    },
    "boundedText": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "alias": {
      "allOf": [
        {
          "$ref": "#/$defs/boundedText"
        },
        {
          "minLength": 1,
          "maxLength": 128
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "target_concept_id"
      ],
      "properties": {
        "relation_type": {
          "type": "string",
          "enum": [
            "broader_than",
            "narrower_than",
            "related_to",
            "depends_on"
          ],
          "minLength": 10,
          "maxLength": 13
        },
        "target_concept_id": {
          "$ref": "#/$defs/conceptId"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "manual",
            "deterministic",
            "model_candidate"
          ],
          "minLength": 6,
          "maxLength": 15
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "canonical_name",
        "aliases",
        "definition",
        "source_bindings",
        "status",
        "provenance"
      ],
      "properties": {
        "concept_id": {
          "$ref": "#/$defs/conceptId"
        },
        "canonical_name": {
          "allOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "aliases": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "definition": {
          "allOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "minLength": 1,
              "maxLength": 4096
            }
          ]
        },
        "relations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "source_bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "https://palimnex.dev/schemas/source-locator.v1.schema.json"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "approved",
            "superseded",
            "withdrawn"
          ],
          "minLength": 8,
          "maxLength": 10
        },
        "predecessor_concept_id": {
          "$ref": "#/$defs/conceptId"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_bindings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
