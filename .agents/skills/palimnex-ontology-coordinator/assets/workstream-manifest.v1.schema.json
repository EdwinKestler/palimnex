{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimnex.dev/schemas/ontology-workstream-manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "approved_phase", "design_identity", "workstreams", "dependency_dag", "exclusive_file_ownership", "shared_file_owner", "acceptance_gates", "authority_limits", "status"],
  "properties": {
    "schema": {"const": "palimnex:ontology-workstream-manifest:v1"},
    "approved_phase": {"type": "integer", "minimum": 0, "maximum": 5},
    "design_identity": {"$ref": "#/$defs/designIdentity"},
    "workstreams": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 64}},
    "dependency_dag": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/workstreamId"}, "to": {"$ref": "#/$defs/workstreamId"}}}},
    "exclusive_file_ownership": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}},
    "shared_file_owner": {"$ref": "#/$defs/workstreamId"},
    "acceptance_gates": {"$ref": "#/$defs/textList"},
    "authority_limits": {"$ref": "#/$defs/textList"},
    "status": {"enum": ["ready", "in_progress", "integration_pending", "validated", "blocked"]}
  },
  "$defs": {
    "workstreamId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+", "maxLength": 512},
    "designIdentity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "textList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  }
}
