{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cleanup-plan.v2.schema.json",
  "title": "Palimnex orchestrated cleanup plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "project_id", "status", "proposed_at", "expires_at", "scope",
    "bindings", "contract", "affected", "exclusions", "dependencies", "packs",
    "bytes", "caveats", "plan_digest"
  ],
  "properties": {
    "schema": {"const": "project-memory:cleanup-plan:v2"},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "refused"]},
    "proposed_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0},
    "scope": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 1, "uniqueItems": true,
         "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}
      ]
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ledger_digest", "policy_digest", "hold_set_digest", "session_pin_digest",
        "pack_manifest_digest", "authorization_digest", "support_digest", "control_digest"
      ],
      "properties": {
        "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hold_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "session_pin_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pack_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorization_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "support_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "control_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "contract": {"type": "object"},
    "affected": {"type": "array", "items": {"type": "object"}},
    "exclusions": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "packs": {"type": "array", "items": {"type": "object"}},
    "bytes": {"type": "object"},
    "caveats": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
