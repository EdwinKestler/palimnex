{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimnex.dev/schemas/ontology-integration-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workstream_receipts", "reviewed_diff", "compatibility_result", "validation_commands", "validation_results", "cache_and_ledger_state", "git_state", "status"],
  "properties": {
    "schema": {"const": "palimnex:ontology-integration-receipt:v1"},
    "workstream_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "reviewed_diff": {"type": "string", "minLength": 1, "maxLength": 4096},
    "compatibility_result": {"type": "string", "minLength": 1, "maxLength": 4096},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "validation_results": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "cache_and_ledger_state": {"type": "object"},
    "git_state": {"type": "object"},
    "status": {"enum": ["integration_pending", "validated", "blocked"]}
  }
}
