{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimnex.dev/schemas/ontology-approval-evidence.v1.schema.json",
  "title": "Palimnex ontology approval evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authority_source", "evidence_locator", "grantor_claim",
    "design_identity", "source_proposal_identity", "approved_phases", "authorized_actions",
    "excluded_actions", "recorded_at", "implementation_authorized"
    , "network_authorized", "git_write_authorized", "live_state_authorized"
  ],
  "properties": {
    "schema": {"const": "palimnex:ontology-approval-evidence:v1"},
    "authority_source": {
      "enum": ["user_message", "repository_approved_design"]
    },
    "evidence_locator": {"type": "string", "minLength": 1, "maxLength": 512},
    "grantor_claim": {"type": "string", "minLength": 1, "maxLength": 256},
    "design_identity": {"$ref": "#/$defs/designIdentity"},
    "source_proposal_identity": {"$ref": "#/$defs/designIdentity"},
    "approved_phases": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 5}
    },
    "authorized_actions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "excluded_actions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "recorded_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "implementation_authorized": {"const": true},
    "network_authorized": {"type": "boolean"},
    "git_write_authorized": {"type": "boolean"},
    "live_state_authorized": {"type": "boolean"}
  },
  "$defs": {
    "designIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+", "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
