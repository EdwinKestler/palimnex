{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palimnex:project-memory:logical-export:v1",
  "title": "Palimnex logical export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "project_slug",
    "sessions",
    "events",
    "workflows"
  ],
  "properties": {
    "schema": {
      "const": "project-memory:logical-export:v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_slug": {
      "type": "string",
      "minLength": 1
    },
    "sessions": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "memory-event.v1.schema.json"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "started_at",
        "ended_at",
        "status",
        "task"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ended_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "status": {
          "enum": [
            1,
            2
          ]
        },
        "task": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "ended_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "ended_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "event_id",
        "name_digest",
        "version",
        "specification"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "name_digest": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "specification": {
          "$ref": "#/$defs/stored_workflow_specification"
        }
      }
    },
    "stored_workflow_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "steps",
        "execution_policy",
        "past_authorization_replayed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflow_step"
          }
        },
        "execution_policy": {
          "const": "dry-run-only"
        },
        "past_authorization_replayed": {
          "const": false
        }
      }
    },
    "workflow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "expected",
        "id",
        "preconditions",
        "rollback",
        "side_effect"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "side_effect": {
          "enum": [
            "none",
            "read",
            "local_write",
            "external_write",
            "destructive"
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    }
  }
}
