      "concept_id": "concept.source_admission",
      "canonical_name": "Source admission and privacy scanning",
      "aliases": [
        "repository privacy scan",
        "credential shaped content scan",
        "admitted source snapshot",
        "bounded repository file read"
      ],
      "definition": "Palimnex opens repository files through a bounded, symlink-refusing reader and scans the exact admitted bytes for credential-shaped content. Source snapshots reject unsafe content before indexing or other derivation.",
