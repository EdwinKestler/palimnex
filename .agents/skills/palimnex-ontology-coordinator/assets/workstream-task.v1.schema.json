{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimnex.dev/schemas/ontology-workstream-task.v1.schema.json",
  "title": "Palimnex ontology implementation task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "workstream_id", "phase", "action_id", "objective", "exclusions",
    "approved_design_identity", "approval_evidence", "owned_paths",
    "read_only_paths", "forbidden_paths", "dependencies",
    "acceptance_commands", "required_output", "network_authority",
    "git_write_authority", "live_state_authority"
  ],
  "properties": {
    "schema": {"const": "palimnex:ontology-workstream-task:v1"},
    "workstream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "phase": {"type": "integer", "minimum": 0, "maximum": 5},
    "action_id": {
      "enum": [
        "ontology_phase_0_contract", "ontology_phase_1_registry",
        "ontology_phase_2_coverage", "ontology_phase_3_shadow",
        "ontology_phase_4_semantic", "ontology_phase_5_extensions"
      ]
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 2048},
    "exclusions": {"$ref": "#/$defs/textList"},
    "approved_design_identity": {"$ref": "#/$defs/designIdentity"},
    "approval_evidence": {
      "$ref": "https://palimnex.dev/schemas/ontology-approval-evidence.v1.schema.json"
    },
    "owned_paths": {"$ref": "#/$defs/nonEmptyPathList"},
    "read_only_paths": {"$ref": "#/$defs/pathList"},
    "forbidden_paths": {"$ref": "#/$defs/pathList"},
    "dependencies": {"$ref": "#/$defs/textList"},
    "acceptance_commands": {"$ref": "#/$defs/nonEmptyTextList"},
    "required_output": {"const": "ImplementationReceipt"},
    "network_authority": {"type": "boolean"},
    "git_write_authority": {"type": "boolean"},
    "live_state_authority": {"type": "boolean"}
  },
  "$defs": {
    "designIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+", "maxLength": 512},
    "pathList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "nonEmptyPathList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "textList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "nonEmptyTextList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  }
}
